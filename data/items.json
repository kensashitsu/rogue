    "S_HOLD":      2,
    "S_SLEEP":     3,
    "S_ARMOR":     4,
    "S_ID_POTION": 5,
    "S_ID_SCROLL": 6,
    "S_ID_WEAPON": 7,
    "S_ID_ARMOR":  8,
    "S_ID_R_OR_S": 9,
    "S_SCARE":    10,

    "CHAIN_MAIL":      4,
    "SPLINT_MAIL":     5,
    "BANDED_MAIL":     6,
    "PLATE_MAIL":      7,
    "MAXARMORS":       8
  },

  "rings": {
    "R_PROTECT":  0,
    "R_ADDSTR":   1,
    "R_SUSTSTR":  2,
    "R_SEARCH":   3,
    "R_SEEINVIS": 4,
    "R_NOP":      5,
    "R_AGGR":     6,
    "R_ADDHIT":   7,
    "R_ADDDAM":   8,
    "R_REGEN":    9,

  },

  "misc_constants": {
    "GOLDCALC":    "rnd(50 + 10 * level) + 2",
    "ISMULT_types":["POTION", "SCROLL", "FOOD"],
    "HUNGERTIME":  1300,
    "MORETIME":    150,
    "STOMACHSIZE": 2000
  },

  "room_flags": {
    "ISDARK": { "value": 1, "description": "room is dark" },
    "ISGONE": { "value": 2, "description": "room is gone (a corridor)" },
    "ISMAZE": { "value": 4, "description": "room is a maze" }
  },

  "map_flags": {
    "F_PASS":    { "value": 128, "description": "is a passageway" },
    "F_SEEN":    { "value":  64, "description": "have seen this spot before" },
    "F_DROPPED": { "value":  32, "description": "object was dropped here" },
    "F_LOCKED":  { "value":  32, "description": "door is locked" },
    "F_REAL":    { "value":  16, "description": "what you see is what you get" },
    "F_PNUM":    { "value":  15, "description": "passage number mask" },
    "F_TMASK":   { "value":   7, "description": "trap number mask" }
  },

  "inventory_types": {
    "INV_OVER":  0,
    "INV_SLOW":  1,
    "INV_CLEAR": 2
  },

  "functions": {
    "add_pack": {
      "description": "Pick up an object and add it to the pack.",
      "scare_scroll": {
        "type":      "SCROLL",
        "which":     "S_SCARE",
        "condition": "ISFOUND",
        "action":    "detach, set FLOOR, discard, msg 'turns to dust'"
      },
      "grouping": {
        "ISMULT":  "increment o_count, discard duplicate",
        "o_group": "merge o_count, decrement inpack"
      },
      "monster_reaction": "if tp->t_dest == &obj->o_pos, redirect t_dest to &hero",
      "amulet":           "if o_type == AMULET, set amulet = TRUE"
    },

    "pack_room": {
      "description": "See if there's room in the pack.",
      "max_pack":    "MAXPACK (23)",
      "overflow":    "inpack reset to MAXPACK, return FALSE"
    },

    "leave_pack": {
      "description": "Take an item out of the pack.",
      "split": {
        "condition": "o_count > 1 && !all",
        "action":    "decrement o_count; if newobj, allocate copy with o_count=1"
      },
      "remove": {
        "condition": "o_count == 1 || all",
        "action":    "detach from pack, pack_used[o_packch - 'a'] = FALSE"
      }
    },

    "pack_char": {
      "description": "Return the next unused pack character.",
      "range":       "a-z",
      "method":      "first FALSE entry in pack_used[] array"
    },

    "inventory": {
      "description": "List what is in the pack. Return TRUE if something of given type.",
      "filter": {
        "0":        "show all",
        "CALLABLE": "exclude FOOD and AMULET",
        "R_OR_S":   "include RING or STICK only"
      }
    },

    "pick_up": {
      "description": "Add something to character's pack.",
      "levitation_check": "if ISLEVIT, return immediately",
      "GOLD": {
        "action": "money(o_goldval), detach and discard, r_goldval = 0"
      },
      "default": {
        "types":  ["ARMOR","POTION","FOOD","WEAPON","SCROLL","AMULET","RING","STICK"],
        "action": "add_pack(NULL, FALSE)"
      }
    },

    "money": {
      "description": "Add or subtract gold from the pack.",
      "operation":   "purse += value",
      "display":     "if value > 0, msg '%d gold pieces'"
    },

    "floor_ch": {
      "description": "Return the appropriate floor character for current room.",
      "ISGONE":  "return PASSAGE ('#')",
      "default": "show_floor() ? FLOOR ('.') : ' '"
    },

    "floor_at": {
      "description": "Return the character at hero's position, accounting for see_floor.",
      "substitution": "if ch == FLOOR, ch = floor_ch()"
    },

    "reset_last": {
      "description": "Reset the last command when the current one is aborted.",
      "fields": ["last_comm", "last_dir", "last_pick"]
    },

    "move_msg": {
      "description": "Print out the message when moving onto an object.",
      "terse":   "msg 'moved onto <name>'",
      "verbose": "msg 'you moved onto <name>'"
    },

    "picky_inven": {
      "description": "Allow player to inventory a single item.",
      "empty":       "msg 'you aren't carrying anything'",
      "single":      "msg 'a) <name>'",
      "multi":       "prompt for pack character, then msg '<ch>) <name>'"
    },

    "get_item": {
      "description": "Pick something out of a pack for a purpose.",
      "abort_key":   "ESCAPE (27)",
      "list_key":    "*",
      "again":       "return last_pick, or msg 'you ran out'"
    }
  }
}

{
  "constants": {
    "MAXPACK":    23,
    "MAXOBJ":      9,
    "NUMTHINGS":   7,
    "MAXPOTIONS": 14,
    "MAXSCROLLS": 18,
    "MAXWEAPONS":  9,
    "MAXARMORS":   8,
    "MAXRINGS":   14,
    "MAXSTICKS":  14,
    "ESCAPE":     27,
    "LEFT":        0,
    "RIGHT":       1
  },

  "screen_chars": {
    "PASSAGE": "#",
    "DOOR":    "+",
    "FLOOR":   ".",
    "PLAYER":  "@",
    "TRAP":    "^",
    "STAIRS":  "%",
    "GOLD":    "*",
    "POTION":  "!",
    "SCROLL":  "?",
    "MAGIC":   "$",
    "FOOD":    ":",
    "WEAPON":  ")",
    "ARMOR":   "]",
    "AMULET":  ",",
    "RING":    "=",
    "STICK":   "/"
  },

  "special_type_values": {
    "CALLABLE": -1,
    "R_OR_S":   -2
  },

  "struct_obj_info": {
    "description": "Stuff about objects",
    "fields": {
      "oi_name":  "char*  (object name)",
      "oi_prob":  "int    (probability)",
      "oi_worth": "int    (value in gold)",
      "oi_guess": "char*  (player's guess at name)",
      "oi_know":  "bool   (player knows the true name)"
    }
  },

  "struct_thing_object": {
    "description": "Object fields of the THING union",
    "fields": {
      "o_type":    "int    (What kind of object it is)",
      "o_pos":     "coord  (Where it lives on the screen)",
      "o_text":    "char*  (What it says if you read it)",
      "o_launch":  "int    (What you need to launch it)",
      "o_packch":  "char   (What character it is in the pack)",
      "o_damage":  "char[8](Damage if used like sword)",
      "o_hurldmg": "char[8](Damage if thrown)",
      "o_count":   "int    (count for plural objects)",
      "o_which":   "int    (Which object of a type it is)",
      "o_hplus":   "int    (Plusses to hit)",
      "o_dplus":   "int    (Plusses to damage)",
      "o_arm":     "int    (Armor protection / charges / gold value)",
      "o_flags":   "int    (information about objects)",
      "o_group":   "int    (group number for this object)",
      "o_label":   "char*  (Label for object)"
    },
    "aliases": {
      "o_charges":  "o_arm",
      "o_goldval":  "o_arm"
    }
  },

  "object_flags": {
    "ISCURSED": { "value":  1, "description": "object is cursed" },
    "ISKNOW":   { "value":  2, "description": "player knows details about the object" },
    "ISMISL":   { "value":  4, "description": "object is a missile type" },
    "ISMANY":   { "value":  8, "description": "object comes in groups" },
    "ISFOUND":  { "value": 16, "description": "object has been found (shared with creature flag)" },
    "ISPROT":   { "value": 32, "description": "armor is permanently protected" }
  },

  "potions": {
    "P_CONFUSE":  0,
    "P_LSD":      1,
    "P_POISON":   2,
    "P_STRENGTH": 3,
    "P_SEEINVIS": 4,
    "P_HEALING":  5,
    "P_MFIND":    6,
    "P_TFIND":    7,
    "P_RAISE":    8,
    "P_XHEAL":    9,
    "P_HASTE":   10,
    "P_RESTORE": 11,
    "P_BLIND":   12,
    "P_LEVIT":   13,
    "MAXPOTIONS":14
  },

  "scrolls": {
    "S_CONFUSE":   0,
